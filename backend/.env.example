PORT=3000

# Use explicit ISO-8601 timestamps with a timezone (UTC shown here).
ELECTION_START_TIME=2026-11-01T09:00:00Z
ELECTION_END_TIME=2026-11-01T17:00:00Z

# Local demo IDs only. Replace with the UGR IDs of the Student Affairs
# President and Vice President who are appointed as the two proposal judges.
STUDENT_AFFAIRS_JUDGE_IDS=UGR/0001/15,UGR/0002/15

# Required: comma-separated list of 50–100 registered, eligible parliament voter IDs.
# Configure this from the official parliament voter roster before the election.
PARLIAMENT_VOTER_IDS=

# UGR/0001/15 becomes ugr-0001-15@astu.edu.et.
STUDENT_EMAIL_DOMAIN=astu.edu.et

# SMTP account used by the backend to deliver voting tokens.
SMTP_HOST=smtp.example.edu.et
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=elections@astu.edu.et
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=elections@astu.edu.et

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable and secret across server restarts; this key encrypts pending email retries.
VOTING_TOKEN_SECRET=replace-with-at-least-32-random-bytes
